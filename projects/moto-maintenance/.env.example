# Moto Maintenance Supabase project only (not Flowtask).
# Copy this file to .env and fill in values from the new project.
# Project Settings → API: Project URL and anon / publishable public key.

VITE_MOTO_SUPABASE_URL=https://YOUR_MOTO_PROJECT.supabase.co
VITE_MOTO_SUPABASE_ANON_KEY=your_moto_anon_public_key
